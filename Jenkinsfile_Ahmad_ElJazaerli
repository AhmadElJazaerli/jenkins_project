pipeline {
  agent any

  options { timestamps() }

  stages {
    stage('Setup') {
      steps {
        bat '''
          where python
          python -m venv venv
          venv\\Scripts\\python -m pip install --upgrade pip
          if exist requirements.txt venv\\Scripts\\python -m pip install -r requirements.txt
        '''
      }
    }

    stage('Lint') {
      steps {
        bat '''
          venv\\Scripts\\python -m pip install flake8
          venv\\Scripts\\python -m flake8 .
        '''
      }
    }

    stage('Test') {
      steps {
        bat '''
          venv\\Scripts\\python -m pip install pytest
          venv\\Scripts\\python -m pytest --junitxml=reports\\junit.xml
        '''
      }
      post {
        always {
          junit 'reports/junit.xml'
        }
      }
    }

    stage('Deploy') {
      when { expression { return false } } // set your real deploy condition/steps here
      steps {
        bat 'echo Deploy step goes here'
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
