pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}/${VIRTUAL_ENV}")) {
                        sh "python -m venv ${VIRTUAL_ENV}"
                    }
                    // Install project deps + tools needed for new stages
                    sh """
                        source ${VIRTUAL_ENV}/bin/activate
                        pip install -r requirements.txt
                        pip install coverage bandit
                    """
                }
            }
        }

        stage('Lint') {
            steps {
                sh "source ${VIRTUAL_ENV}/bin/activate && flake8 *.py"
            }
        }

        stage('Test') {
            steps {
                sh "source ${VIRTUAL_ENV}/bin/activate && pytest -q"
            }
        }

        stage('Coverage') {
            steps {
                sh """
                    source ${VIRTUAL_ENV}/bin/activate
                    coverage run -m pytest
                    coverage xml -o coverage.xml
                    coverage html
                """
                // Save reports (HTML + XML) to the build
                archiveArtifacts artifacts: 'coverage.xml, htmlcov/**', fingerprint: true
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    // Run bandit and mark build 'Unstable' if issues are found (but do not fail)
                    int status = sh(
                        returnStatus: true,
                        script: """
                            source ${VIRTUAL_ENV}/bin/activate
                            bandit -r . -f json -o bandit-report.json
                        """
                    )
                    archiveArtifacts artifacts: 'bandit-report.json', fingerprint: true
                    if (status != 0) {
                        unstable("Bandit found security issues. See bandit-report.json artifact.")
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    // Minimal example deployment: create a tarball artifact.
                    // Replace with your actual: e.g., scp/rsync to server, docker build & push, etc.
                    sh """
                        tar -czf build.tgz app.py requirements.txt tests || true
                        echo "Deploying artifact build.tgz (placeholder). Replace with real steps."
                    """
                    archiveArtifacts artifacts: 'build.tgz', fingerprint: true
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
