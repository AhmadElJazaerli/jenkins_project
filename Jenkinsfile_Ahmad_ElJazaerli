pipeline {
  agent any

  environment {
    VENV_DIR = '.venv'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Setup') {
      steps {
        script {
          def PY = isUnix() ? 'python3' : 'py -3'
          if (isUnix()) {
            sh """
              ${PY} -m venv ${VENV_DIR}
              ${VENV_DIR}/bin/python -m pip install --upgrade pip
              ${VENV_DIR}/bin/pip install -r requirements.txt
              ${VENV_DIR}/bin/pip install coverage bandit build
            """
          } else {
            bat """
              ${PY} -m venv ${VENV_DIR}
              call ${VENV_DIR}\\Scripts\\python -m pip install --upgrade pip
              call ${VENV_DIR}\\Scripts\\pip install -r requirements.txt
              call ${VENV_DIR}\\Scripts\\pip install coverage bandit build
            """
          }
        }
      }
    }

    stage('Lint') {
      steps {
        script {
          if (isUnix()) sh "${VENV_DIR}/bin/flake8 app.py"
          else          bat "call ${VENV_DIR}\\Scripts\\flake8 app.py"
        }
      }
    }

    stage('Test') {
      steps {
        script {
          if (isUnix()) {
            withEnv(["PYTHONPATH=${env.WORKSPACE}"]) {
              sh "${VENV_DIR}/bin/pytest -q"
            }
          } else {
            withEnv(["PYTHONPATH=${env.WORKSPACE}"]) {
              bat "call ${VENV_DIR}\\Scripts\\pytest -q"
            }
          }
        }
      }
    }

    stage('Coverage') {
      steps {
        script {
          if (isUnix()) {
            withEnv(["PYTHONPATH=${env.WORKSPACE}"]) {
              sh """
                ${VENV_DIR}/bin/python -m coverage erase
                ${VENV_DIR}/bin/python -m coverage run -m pytest
                ${VENV_DIR}/bin/python -m coverage html -d coverage_html
              """
            }
          } else {
            withEnv(["PYTHONPATH=${env.WORKSPACE}"]) {
              bat """
                call ${VENV_DIR}\\Scripts\\python -m coverage erase
                call ${VENV_DIR}\\Scripts\\python -m coverage run -m pytest
                call ${VENV_DIR}\\Scripts\\python -m coverage html -d coverage_html
              """
            }
          }
        }
      }
      post {
        always {
          archiveArtifacts artifacts: 'coverage_html/**', onlyIfSuccessful: false, allowEmptyArchive: true
        }
      }
    }

    stage('Security Scan') {
      steps {
        script {
          if (isUnix())
            sh "${VENV_DIR}/bin/python -m bandit -r . -x ${VENV_DIR} -f txt -o bandit_report.txt || true"
          else
            bat "call ${VENV_DIR}\\Scripts\\python -m bandit -r . -x ${VENV_DIR} -f txt -o bandit_report.txt || exit /b 0"
        }
      }
      post {
        always { archiveArtifacts artifacts: 'bandit_report.txt', onlyIfSuccessful: false }
      }
    }

    stage('Package') {
      steps {
        script {
          if (fileExists('scripts/package_app.py')) {
            if (isUnix())
              sh "${VENV_DIR}/bin/python scripts/package_app.py"
            else
              bat "call ${VENV_DIR}\\Scripts\\python scripts\\package_app.py"
          } else if (fileExists('pyproject.toml') || fileExists('setup.cfg') || fileExists('setup.py')) {
            if (isUnix())
              sh "${VENV_DIR}/bin/python -m build"
            else
              bat "call ${VENV_DIR}\\Scripts\\python -m build"
          } else {
            if (isUnix()) {
              sh """
                rm -rf dist || true
                mkdir -p dist
                tar -czf dist/app.tar.gz app.py requirements.txt || true
              """
            } else {
              bat """
                if exist dist rmdir /s /q dist
                mkdir dist
                powershell -NoProfile -Command "Compress-Archive -Path app.py, requirements.txt -DestinationPath dist\\app.zip -Force"
              """
            }
          }
        }
      }
      post {
        always {
          archiveArtifacts artifacts: 'dist/**', onlyIfSuccessful: false, allowEmptyArchive: true, fingerprint: true
        }
      }
    }

    stage('Deploy') {
      when {
        expression {
          isUnix() ? fileExists('scripts/deploy_local.sh') : fileExists('scripts\\deploy_local.ps1')
        }
      }
      steps {
        script {
          if (isUnix()) {
            sh "bash scripts/deploy_local.sh"
          } else {
            bat "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\deploy_local.ps1"
          }
        }
      }
    }
  }
}
