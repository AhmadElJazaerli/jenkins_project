pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}\\${VIRTUAL_ENV}")) {
                        bat "python -m venv %VIRTUAL_ENV%"
                    }
                    bat """
                        call %VIRTUAL_ENV%\\Scripts\\activate
                        pip install -r requirements.txt
                        pip install coverage bandit
                    """
                }
            }
        }

        stage('Lint') {
            steps {
                bat "call %VIRTUAL_ENV%\\Scripts\\activate && flake8 *.py"
            }
        }

        stage('Test') {
            steps {
                bat "call %VIRTUAL_ENV%\\Scripts\\activate && pytest -q"
            }
        }

        stage('Coverage') {
            steps {
                bat """
                    call %VIRTUAL_ENV%\\Scripts\\activate
                    coverage run -m pytest
                    coverage xml -o coverage.xml
                    coverage html
                """
                archiveArtifacts artifacts: 'coverage.xml, htmlcov/**', fingerprint: true
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    def status = bat(
                        returnStatus: true,
                        script: """
                            call %VIRTUAL_ENV%\\Scripts\\activate
                            bandit -r . -f json -o bandit-report.json
                        """
                    )
                    archiveArtifacts artifacts: 'bandit-report.json', fingerprint: true
                    if (status != 0) {
                        unstable("Bandit found security issues. See bandit-report.json artifact.")
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                bat """
                    tar -czf build.tgz app.py requirements.txt test_app.py
                    echo Deploying artifact build.tgz (placeholder)
                """
                archiveArtifacts artifacts: 'build.tgz', fingerprint: true
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
