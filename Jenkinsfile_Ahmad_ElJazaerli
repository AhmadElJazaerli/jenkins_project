pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    // Create venv if missing
                    if (!fileExists("${env.WORKSPACE}\\${VIRTUAL_ENV}")) {
                        bat "python -m venv %VIRTUAL_ENV%"
                    }
                    // Install deps + tooling
                    bat """
                        call %VIRTUAL_ENV%\\Scripts\\activate
                        pip install -r requirements.txt
                        pip install coverage bandit
                    """
                }
            }
        }

        stage('Lint') {
            steps {
                bat """
                    call %VIRTUAL_ENV%\\Scripts\\activate
                    flake8 --exit-zero
                """
            }
        }

        stage('Test') {
            steps {
                bat "call %VIRTUAL_ENV%\\Scripts\\activate && python -m pytest -q"
            }
        }

        stage('Coverage') {
            steps {
                bat """
                    call %VIRTUAL_ENV%\\Scripts\\activate
                    coverage run -m pytest
                    coverage xml -o coverage.xml
                    coverage html
                """
                archiveArtifacts artifacts: 'coverage.xml, htmlcov/**', fingerprint: true
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    def status = bat(
                        returnStatus: true,
                        script: """
                            call %VIRTUAL_ENV%\\Scripts\\activate
                            bandit -r . -f json -o bandit-report.json
                        """
                    )
                    archiveArtifacts artifacts: 'bandit-report.json', fingerprint: true
                    if (status != 0) {
                        unstable("Bandit found security issues. See bandit-report.json.")
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                // Create a ZIP artifact (Windows-safe)
                bat """
                    if exist build.zip del /f /q build.zip
                    powershell -NoLogo -NoProfile -Command ^
                      "Compress-Archive -Path app.py, requirements.txt, test_app.py -DestinationPath build.zip"
                    echo Deploying artifact build.zip (placeholder).
                """
                archiveArtifacts artifacts: 'build.zip', fingerprint: true
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}